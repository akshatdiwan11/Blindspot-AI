# Copy to .env and fill in what you need. Every value has a safe default.

# --- Database -------------------------------------------------------------
# docker-compose sets this for you. For a local run without Docker:
DATABASE_URL=postgresql+psycopg2://blindspot:blindspot@localhost:5432/blindspot

# Comma-separated list of web origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Upload limits ----------------------------------------------------------
MAX_UPLOAD_MB=10
MAX_ROWS=20000
# Delete projects older than this many days (0 = keep forever).
RETENTION_DAYS=0

# --- Failure discovery --------------------------------------------------------
MIN_GROUP_SIZE=20
FDR_ALPHA=0.05

# --- AI investigator (optional) ----------------------------------------------
# Without a key, everything works except LLM hypotheses; the evidence package is still built.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# For an OpenAI-compatible provider instead:
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# Investigations stop for the day once estimated spend reaches this amount.
LLM_DAILY_BUDGET_USD=2.0

# --- Optional semantic similarity ----------------------------------------------
# Needs: pip install -r backend/requirements-embeddings.txt
ENABLE_EMBEDDINGS=false
